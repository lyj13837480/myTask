{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Hardhat Script Debug",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "hardhat",
                "run",
                "${file}",
                "--network",
                "hardhat"
            ],
            "cwd": "${workspaceFolder}\\solidity\\task3",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}solidity/task3/artifacts/**/*.js"
            ]
        }
    ]
}